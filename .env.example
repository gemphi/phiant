# M-KOPA AI Ops Agent Platform
# Copy this file to .env and fill in your values

# --- LLM Configuration ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Enterprise Connectors ---
# Microsoft Entra ID (Azure AD)
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# Notion
NOTION_API_KEY=ntn_your-key-here

# HiBob
HIBOB_API_KEY=your-hibob-api-key
HIBOB_SERVICE_USER=your-service-user-id

# --- Infrastructure ---
CHROMA_PERSIST_DIR=./data/chroma
AUDIT_DB_PATH=./data/audit.db
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret

# --- Azure (optional, for production) ---
# AZURE_AI_SEARCH_ENDPOINT=https://your-search.search.windows.net
# AZURE_AI_SEARCH_KEY=your-search-key
# AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
# AZURE_OPENAI_KEY=your-openai-key
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
