{
  "agent_id": "phillm",
  "agent_name": "PhiLLM",
  "layer": "Engine",
  "description": "LLM endpoint provider, parameter configuration, token counting, and multi-provider inference (OpenAI, Anthropic, Gemini, Local).",
  "version": "1.0.0",
  "specs": [
    {
      "spec_idx": "LLM_MODEL_ACCESS_V1",
      "spec_id": "LLM_MODEL_ACCESS_V1",
      "version": "1.0.0",
      "name": "",
      "description": "Multi-provider LLM inference, embedding generation, streaming, parameter hot-swapping, and token tracking.",
      "required_tasks": [
        "inference",
        "configuration",
        "endpoint_health"
      ],
      "tasks": []
    }
  ],
  "tasks": [
    {
      "task_id": "inference",
      "name": "Model Inference",
      "description": "Run completions and generate embeddings across models.",
      "verbs": [
        {
          "verb": "complete",
          "description": "Run chat completion against active model",
          "parameters": {
            "prompt": "str",
            "model": "str"
          },
          "returns": "Any"
        },
        {
          "verb": "embed",
          "description": "Generate vector embeddings for input text",
          "parameters": {
            "text": "str",
            "model": "str"
          },
          "returns": "Any"
        },
        {
          "verb": "count_tokens",
          "description": "Count tokens for given input text",
          "parameters": {
            "text": "str"
          },
          "returns": "Any"
        }
      ]
    },
    {
      "task_id": "configuration",
      "name": "Model Configuration",
      "description": "Inspect and adjust model parameters.",
      "verbs": [
        {
          "verb": "get_config",
          "description": "Retrieve active model profile configuration",
          "parameters": {},
          "returns": "Any"
        },
        {
          "verb": "set_params",
          "description": "Update temperature, max_tokens, or endpoint settings",
          "parameters": {
            "temperature": "float",
            "max_tokens": "int"
          },
          "returns": "Any"
        },
        {
          "verb": "get_usage",
          "description": "Retrieve total token consumption metrics",
          "parameters": {},
          "returns": "Any"
        }
      ]
    },
    {
      "task_id": "endpoint_health",
      "name": "Endpoint Health",
      "description": "Check reachability and validate credentials.",
      "verbs": [
        {
          "verb": "ping",
          "description": "Ping model API endpoint",
          "parameters": {},
          "returns": "Any"
        },
        {
          "verb": "validate",
          "description": "Validate API credentials and permissions",
          "parameters": {},
          "returns": "Any"
        }
      ]
    }
  ],
  "dependencies": [
    "phiora"
  ],
  "external_services": [
    "OpenAI API",
    "Anthropic API",
    "Google AI API",
    "Ollama (Local)"
  ],
  "verbs": [
    "complete",
    "embed",
    "count_tokens",
    "get_config",
    "set_params",
    "get_usage",
    "ping",
    "validate"
  ]
}